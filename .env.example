# PCClub Server Configuration
# Copy this file to .env and adjust values as needed

# Server settings
PORT=8080
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
MAX_HEADER_BYTES=1048576

# Database settings
DATABASE_PATH=data/pcclub.db
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# Security settings
JWT_SECRET=your-secure-jwt-secret-here
ADMIN_API_TOKEN=your-admin-token-here

# Demo data (set to false in production)
SEED_DEMO_DATA=true

# Production optimizations (uncomment for production)
# READ_TIMEOUT=30s
# WRITE_TIMEOUT=30s
# IDLE_TIMEOUT=120s
# DB_MAX_OPEN_CONNS=50
# DB_MAX_IDLE_CONNS=10
# SEED_DEMO_DATA=false